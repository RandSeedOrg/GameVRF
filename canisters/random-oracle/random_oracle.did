type BusinessType = variant {
  LuckyNickel;
  Keno;
  Daily4;
  QuickQuid;
  Roulette;
  Mines;
  RoyalTreys;
  GameCreator;
  FruitsGarden;
};
type LegacyBusinessType = variant {
  LuckyNickel;
  Keno;
  Daily4;
  QuickQuid;
  Roulette;
  Mines;
  RoyalTreys;
  FruitsGarden;
};
type LegacyRandSeedVO = record {
  idx : nat64;
  seed : blob;
  use_for : LegacyBusinessType;
  created_by : text;
  scene : LegacyScene;
  create_time : nat64;
  public_time : nat64;
};
type LegacyScene = variant { GenerateTicketPool; Shuffle; DrawNumbers };
type RandSeedVO = record {
  idx : nat64;
  seed : blob;
  use_for : BusinessType;
  created_by : text;
  scene : Scene;
  create_time : nat64;
  public_time : nat64;
};
type Result = variant { Ok; Err : text };
type Scene = variant { GenerateTicketPool; MatchSeed; Shuffle; DrawNumbers };
type SeedPoolConfig = record {
  failure_cooldown_secs : nat64;
  target_size : nat32;
};
type SystemConfig = record { user_role_permissions : vec UserRolePermissionVo };
type UserRolePermissionVo = record {
  permission_codes : vec text;
  principal_id : text;
};
service : () -> {
  add_authorized_caller : (principal) -> (Result);
  add_authorized_callers : (vec principal) -> (Result);
  generate_rand_seed : (BusinessType, Scene) -> (RandSeedVO);
  generate_rand_seed_v2 : (BusinessType, Scene) -> (RandSeedVO);
  get_authorized_callers : () -> (vec principal) query;
  get_public_rand_seed : (nat64) -> (opt LegacyRandSeedVO) query;
  get_public_rand_seed_v2 : (nat64) -> (opt RandSeedVO) query;
  get_public_rand_seeds : (vec nat64) -> (vec opt LegacyRandSeedVO) query;
  get_public_rand_seeds_v2 : (vec nat64) -> (vec opt RandSeedVO) query;
  get_seed_pool_config : () -> (SeedPoolConfig) query;
  initialize_authorized_callers : (vec principal) -> (Result);
  public_rand_seed : (nat64) -> (Result);
  public_rand_seeds : (vec nat64) -> (Result);
  remove_authorized_caller : (principal) -> (Result);
  setup_subscribe : (principal) -> (text);
  update_seed_pool_config : (SeedPoolConfig) -> (Result);
  update_system_configs : (SystemConfig) -> ();
}
